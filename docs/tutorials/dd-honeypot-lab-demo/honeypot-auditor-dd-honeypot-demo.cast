[19.306117, "o", "\u001b[36m╭─\u001b[0m\u001b[36m───────────────────────────────────────\u001b[0m\u001b[36m Honeypot Auditor \u001b[0m\u001b[36m───────────────────────────────────────\u001b[0m\u001b[36m─╮\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2mTarget      \u001b[0m\u001b[2m  \u001b[0m127.0.0.1 (127.0.0.1)                                                              \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2mHoneyscore  \u001b[0m\u001b[2m  \u001b[0m\u001b[1m100.0%\u001b[0m (global)                                                                    \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2mConfidence  \u001b[0m\u001b[2m  \u001b[0mhigh                                                                               \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2mTactical    \u001b[0m\u001b[2m  \u001b[0mSKIP_TARGET                                                                        \u001b[36m│\u001b[0m\r\n\u001b[36m│\u001b[0m \u001b[2mThreat level\u001b[0m\u001b[2m  \u001b[0m\u001b[1;31mConfirmed Honeypot   \u001b[0m                                                              \u001b[36m│"]
[22.306117, "o", "\u001b[0m\r\n\u001b[36m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[22.311084, "o", "\u001b[3m                               Strategy contributions                                \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━┳━━━━━━┳━━━━━━━━┳━━━━━━┳━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mStrategy                          \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mWeight\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mHits\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1m Intra\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mHit \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mContribution\u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━╇━━━━━━╇━━━━━━━━╇━━━━━━╇━━━━━━━━━━━━━━┩\r\n│ Passive intel (Shodan / plugins)   │    25% │    — │      — │ \u001b[2mskip\u001b[0m │         0.0% │\r\n│ Arbitrary auth                     │  bonus │    "]
[22.311189, "o", "— │      — │ \u001b[31myes\u001b[0m  │       100.0% │\r\n│ State non-persistence              │    25% │    3 │ +15.0% │ \u001b[31myes\u001b[0m  │        40.0% │\r\n│ Static signature                   │    20% │    4 │ +15.0% │ \u001b[31myes\u001b[0m  │        35.0% │\r\n│ Multi-service honeypot buffet      │    15% │    — │      — │ \u001b[2mskip\u001b[0m │         0.0% │\r\n│ Multi-protocol corroboration bonus │  bonus │    — │      — │ \u001b[31myes\u001b[0m  │        30.0% │\r\n└────────────────────────────────────┴────────┴──────┴────────┴──────┴──────────────┘\r\n"]
[22.311705, "o", "\u001b[1mScore formula\u001b[0m  categories \u001b[1;36m105.0\u001b[0m% + bonuses \u001b[1;36m30.0\u001b[0m% = raw \u001b[1;36m135.0\u001b[0m% → capped at \u001b[1;36m100\u001b[0m% → repeated arbitrary \r\nauth override to \u001b[1;36m100\u001b[0m% → global \u001b[1;36m100.0\u001b[0m%\r\n"]
