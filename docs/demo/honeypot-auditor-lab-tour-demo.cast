[6.982287, "o", "             │\r\n│ skip       │ shodan         │ Shodan host tag contains         │ no API key (--shodan-key or     │\r\n│            │                │ honeypot                         │ SHODAN_API_KEY)                 │\r\n│ skip       │ shodan         │ Shodan reports many open         │ no API key (--shodan-key or     │\r\n│            │                │ services                         │ SHODAN_API_KEY)                 │\r\n│ skip       │ shodan         │ Shodan port buffet with          │ no API key (--shodan-key or     │\r\n│            │                │ identical product strings        │ SHODAN_API_KEY)                 │\r\n│ clean      │ ssh:22         │ SSH static banner signature      │ SSH-2.0-OpenSSH_8.9p1           │\r\n│            │                │                                  │ Ubuntu-3ubuntu0.10              │\r\n│ HIT        │ ssh:22         │ SSH OpenSSH banner with          │ OpenSSH_8.9p1 banner with       │"]
[6.982331, "o", "\r\n│            │                │ Twisted/Cowrie KEX facade        │ Twisted/Cowrie KEX facade:      │\r\n│            │                │                                  │ host_key prefers ssh-rsa        │\r\n│            │                │                                  │ without rsa-sha2-*; enc lacks   │\r\n│            │                │                                  │ AEAD (chacha20/gcm) but still   │\r\n│            │                │                                  │ offers CBC/3DES; MAC lacks      │\r\n│            │                │                                  │ *-etm@openssh.c                 │\r\n│ clean      │ ssh:22         │ SSH OpenSSH banner advertises    │ auth methods=publickey,         │\r\n│            │                │ password-only auth               │ password;                       │\r\n│            │                │                                  │ banner=SSH-2.0-OpenSSH_8.9p1    │\r\n│           "]
