[6.793921, "o", "                                             Indicators                                             \r\n┏━━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\r\n┃ Status     ┃ Fidelity  ┃ Protocol     ┃ Finding                    ┃ Detail                      ┃\r\n┡━━━━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┩\r\n│ clean      │ medium    │ ssh:28222    │ SSH static banner          │ SSH-2.0-OpenSSH_9.2p1       │\r\n│            │           │              │ signature                  │ Debian-2+"]
[6.793951, "o", "deb12u3            │\r\n│ HIT        │ high      │ ssh:28222    │ SSH OpenSSH banner with    │ OpenSSH_9.2p1 banner with   │\r\n│            │           │              │ Twisted/Cowrie KEX facade  │ Twisted/Cowrie KEX facade:  │\r\n│            │           │              │                            │ host_key prefers ssh-rsa    │\r\n│            │           │              │                            │ without rsa-sha2-*; enc     │\r\n│            │           │              │                            │ lacks AEAD (chacha20/gcm)   │\r\n│            │           │              │                            │ but still offers CBC/3DES;  │\r\n│            │           │              │                            │ MAC l                       │\r\n│ clean      │ medium    │ ssh:28222    │ SSH OpenSSH banner         │ auth methods=publickey,     │\r\n│            │           │              │ advertises password-only   │ passwor"]
[6.794014, "o", "d;                   │\r\n│            │           │              │ auth                       │ banner=SSH-2.0-OpenSSH_9.2… │\r\n│            │           │              │                            │ Debian-2+deb12u3            │\r\n│ HIT        │ medium    │ ssh:28222    │ SSH arbitrary credential   │ random user_a79:****        │\r\n│            │           │              │ acceptance                 │ accepted; 2nd login         │\r\n│            │           │              │                            │ user_a61:**** also accepted │\r\n│ HIT        │ medium    │ ssh:28222    │ SSH exec channel missing   │ exec_command failed after   │\r\n│            │           │              │ after login (fake shell    │ random login; interactive   │\r\n│            │           │              │ only)                      │ shell is a lure             │\r\n│ HIT        │ medium    │ ssh:28222    │ SSH uname/cpuinfo / Cowrie │ cow"]
[6.794067, "o", "rie-default-hostname=sv… │\r\n│            │           │              │ identity                   │ no bash arithmetic          │\r\n│            │           │              │                            │ (expected 63); pipe         │\r\n│            │           │              │                            │ utilities missing           │\r\n│ HIT        │ medium    │ ssh:28222    │ SSH whoami/prompt is the   │ session identity is lure    │\r\n│            │           │              │ random lure account        │ account user_a79            │\r\n│ clean      │ medium    │ ssh:28222    │ SSH filesystem does not    │ canary 2a94c3a5 still       │\r\n│            │           │              │ persist across sessions    │ present after reconnect     │\r\n│ HIT        │ high      │ multi        │ High-signal decoy          │ +15% for high-fidelity      │\r\n│            │           │              │ fingerprint                │"]
[6.794078, "o", " tell(s): ssh.kex_facade     │\r\n└────────────┴───────────┴──────────────┴────────────────────────────┴─────────────────────────────┘\r\n"]
[6.794165, "o", "Why this score\r\n"]
[9.794165, "o", "  • [ssh:28222] (high) SSH OpenSSH banner with Twisted/Cowrie KEX facade — OpenSSH_9.2p1 banner with\r\nTwisted/Cowrie KEX facade: host_key prefers ssh-rsa without rsa-sha2-*; enc lacks AEAD \r\n(chacha20/gcm) but still offers CBC/3DES; MAC lacks *-etm@openssh.com; KEX includes group14-sha1 \r\nwithout group-exchange-sha256\r\n"]
[9.794244, "o", "  • [ssh:28222] (medium) SSH arbitrary credential acceptance — random user_a79:**** accepted; 2nd \r\nlogin user_a61:**** also accepted\r\n"]
[9.794321, "o", "  • [ssh:28222] (medium) SSH exec channel missing after login (fake shell only) — exec_command \r\nfailed after random login; interactive shell is a lure\r\n"]
[9.794423, "o", "  • [ssh:28222] (medium) SSH uname/cpuinfo / Cowrie identity — cowrie-default-hostname=svr04; no \r\nbash arithmetic (expected 63); pipe utilities missing\r\n"]
[9.79449, "o", "  • [ssh:28222] (medium) SSH whoami/prompt is the random lure account — session identity is lure \r\naccount user_a79\r\n"]
[9.794566, "o", "  • [multi] (high) High-signal decoy fingerprint — +15% for high-fidelity tell(s): ssh.kex_facade\r\n"]
[9.794728, "o", "preset=both timeout=6.0s deep=False\r\n"]
[9.794833, "o", "Closed ports are skipped and do not raise the score.\r\n"]
[9.794951, "o", "-p/--port selects only the listed ports (preset not applied)\r\n"]
[9.795038, "o", "ports ssh:28222\r\n"]
[9.795242, "o", "Nmap omitted by default; pass --with-nmap / -n for -sV/NSE tells.\r\n"]
[9.795844, "o", "Report written to /tmp/hpa-cowrie-demo.json\r\n"]
[12.795844, "o", "\r\n  \u001b[38;5;244m▸ reading pause — KEX facade is the Cowrie tell — review the scoreboard\u001b[0m\r\n"]
