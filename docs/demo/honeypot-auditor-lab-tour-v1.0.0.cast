[6.788578, "o", "                               Strategy contributions                                \r\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━┳━━━━━━┳━━━━━━━━┳━━━━━━┳━━━━━━━━━━━━━━┓\r\n┃ Strategy                           ┃ Weight ┃ Hits ┃  Intra ┃ Hit  ┃ Contribution ┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━╇━━━━━━╇━━━━━━━━╇━━━━━━╇━━━━━━━━━━━━━━┩\r\n│ Passive intel (Shodan / plugins)   │    25% │    — │      — │ skip │         0.0% │\r\n│ Arbitrary auth                     │  bonus │    — │      — │ yes  │       100.0% │\r\n│ State non-persistence              │    25% │    1 │      — │ yes  │        25.0% │\r\n│ Stati"]
[6.788642, "o", "c signature                   │    20% │    3 │ +15.0% │ yes  │        35.0% │\r\n│ Multi-service honeypot buffet      │    15% │    — │      — │ skip │         0.0% │\r\n│ Multi-protocol corroboration bonus │  bonus │    — │      — │ yes  │        15.0% │\r\n└────────────────────────────────────┴────────┴──────┴────────┴──────┴──────────────┘\r\n"]
[6.788888, "o", "Score formula  categories 90.0% + bonuses 15.0% = raw 105.0% → capped at 100% → repeated arbitrary \r\nauth override to 100% → global 100.0%\r\n"]
[6.789064, "o", "Intra-category  static_signature +15.0%  (+7.5% per extra hit in same category, cap +15%)\r\n"]
[6.789168, "o", "Bonuses  high_signal_fingerprint +15.0%\r\n"]
[6.789352, "o", "Scoped formula  (105.0% / 75.0% in-scope) × 100 = 100.0%  \r\n"]
[6.789467, "o", "Threat level uses max(global, scoped) on single-port (-p) audits.\r\n"]
[6.790329, "o", "                                        Protocol strategies                                         \r\n┏━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━┓\r\n┃              ┃              ┃                      ┃ State                ┃                      ┃\r\n┃ Protocol     ┃ Ports        ┃ Arbitrary auth       ┃ non-persistence      ┃ Static signature     ┃\r\n┡━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━┩\r\n│ ssh          │ 28222        │ HIT  any-password (2 │ HIT  exec vs fake    │ HI"]
