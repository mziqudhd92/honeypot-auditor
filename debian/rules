#!/usr/bin/make -f

export DH_VERBOSE = 1
export PYBUILD_NAME = honeypot_auditor
export PYBUILD_SYSTEM = pyproject

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	# Tests run in upstream CI; skip network-heavy suite during package builds.
	@echo "Skipping dh_auto_test (covered by GitHub Actions)"
